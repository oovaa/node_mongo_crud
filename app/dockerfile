FROM oven/bun:latest

ARG VITE_API_URL="http://143.110.226.0:3232/api"
ENV VITE_API_URL=${VITE_API_URL}

WORKDIR /app

# Copy entire app into the container (needed for the build step)
COPY . /

# Install dependencies and build the Vite app. VITE_API_URL is injected at build time
# so the built bundle will call the backend service inside the Compose network.
RUN bun install
RUN bun run build

EXPOSE 5463

CMD ["bun", "preview", "--host"]